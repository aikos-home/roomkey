# Copy to secrets.yaml. Generate api_key with: python3 -c 'import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())'
api_key: "<32-byte base64>"
ota_password: "<random>"
ap_password: "<min 8 chars>"
# your 2.4 GHz Wi-Fi (the ESP32-C6 has no 5 GHz):
wifi_ssid: "<network name>"
wifi_password: "<password>"
# shared with the door station (same value on every RoomKey and on the door; never committed):
key_link_key: "<from the door thread>"
ring_transport_key: "<from the door thread>"
# IP of the door talk computer (packages/roomkey_link.yaml):
door_talk_host: "192.168.x.y"
